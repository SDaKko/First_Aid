<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Фрагмент заголовка -->
        <fragment
            android:id="@+id/headerFragment"
            android:name="com.example.first_aid.HeaderFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout="@layout/fragment_header" />

        <!-- Фрагмент полей ввода -->
        <fragment
            android:id="@+id/inputFieldsFragment"
            android:name="com.example.first_aid.InputFieldsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout="@layout/fragment_input_fields" />

        <!-- Фрагмент кнопок -->
        <fragment
            android:id="@+id/actionsFragment"
            android:name="com.example.first_aid.ActionsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout="@layout/fragment_actions" />

    </LinearLayout>
</ScrollView>